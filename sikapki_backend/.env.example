# =========================================================
# SIKAP-KI NTB - Environment Variables Template
# Salin file ini menjadi ".env" lalu isi dengan nilai asli.
# JANGAN commit file ".env" ke git.
# =========================================================

# Django
SECRET_KEY=
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (format: postgres://USER:PASSWORD@HOST:PORT/NAME)
DATABASE_URL=postgres://sikapki_user:sikapki_pass@localhost:5432/sikapki_db

# CORS - domain frontend React yang diizinkan mengakses API saat development
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# AI provider: ollama | gemini | deepseek
# Untuk PC ringan, rekomendasi: AI_PROVIDER=gemini dan AI_MODEL=gemini-2.5-flash-lite
AI_PROVIDER=ollama
AI_MODEL=qwen2.5:latest

# Ollama lokal
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:latest

# Gemini API
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com

# DeepSeek API
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
