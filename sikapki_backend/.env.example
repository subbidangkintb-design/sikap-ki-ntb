# =========================================================
# SIKAP-KI NTB - Environment Variables Template
# Salin file ini menjadi ".env" lalu isi dengan nilai asli.
# JANGAN commit file ".env" ke git.
# =========================================================

# Django
SECRET_KEY=
DEBUG=True
SERVE_STATIC_FILES=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (format: postgres://USER:PASSWORD@HOST:PORT/NAME)
DATABASE_URL=postgres://sikapki_user:sikapki_pass@localhost:5432/sikapki_db

# CORS - domain frontend React yang diizinkan mengakses API saat development
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# AI provider: ollama | gemini | deepseek
# Provider cloud tanpa model lokal: AI_PROVIDER=gemini dan AI_MODEL=gemini-3.1-flash-lite
AI_PROVIDER=gemini
AI_MODEL=gemini-3.1-flash-lite
# Aktifkan bila DNS IPv6 tersedia tetapi koneksi IPv6 perangkat tidak berfungsi.
AI_FORCE_IPV4=True
BACKGROUND_JOB_MAX_ATTEMPTS=3
BACKGROUND_JOB_POLL_SECONDS=5
BACKGROUND_JOB_STALE_MINUTES=120
CLASSIFICATION_TOP_K=3
AI_REQUEST_RETRIES=2
AI_RETRY_BACKOFF_SECONDS=1
# Opsional: fallback cloud provider jika provider utama gagal.
AI_FALLBACK_PROVIDER=
AI_FALLBACK_MODEL=

# Notifikasi email status konsultasi (gunakan backend SMTP saat produksi)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=25
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=False
DEFAULT_FROM_EMAIL=SIKAP-KI NTB <no-reply@sikapki.ntb>

# Ollama lokal
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:latest

# Gemini API
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
GEMINI_EMBEDDING_DIMENSIONS=768
GEMINI_EMBEDDING_BATCH_SIZE=20
# Embedding lokal opsional (tanpa kuota API Gemini untuk RAG)
EMBEDDING_PROVIDER=gemini
LOCAL_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
LOCAL_EMBEDDING_DEVICE=cpu
LOCAL_EMBEDDING_BATCH_SIZE=16
LOCAL_EMBEDDING_CACHE=
EMBEDDING_CHUNK_SIZE=500
EMBEDDING_CHUNK_OVERLAP=50
CHROMA_COLLECTION_NAME=knowledge_chunks
PDF_OCR_WITH_GEMINI=True
PDF_OCR_BATCH_PAGES=3
GEMINI_OCR_MODEL=gemini-3.1-flash-lite

# Batas dokumen knowledge base (100 MB dalam byte)
MAX_DOCUMENT_UPLOAD_SIZE=104857600
MAX_DOCUMENT_TEXT_CHARS=5000000

# Operasional, SLA, dan pembatasan trafik publik
HUMAN_OVERSIGHT_SLA_HOURS=24
SERVICE_LOG_RETENTION_DAYS=365
CHATBOT_RATE_LIMIT=30/min
TRADEMARK_RATE_LIMIT=20/min
USER_TEST_RATE_LIMIT=10/hour

# Fitur opsional. False = hanya klasifikasi; True = tampilkan juga AI Cek Merek.
AI_TRADEMARK_CHECK_ENABLED=False

# Local: biarkan False/0. Production di belakang proxy HTTPS: gunakan
# True untuk tiga opsi pertama. Aktifkan HSTS secara bertahap setelah domain
# dan HTTPS terverifikasi (mis. mulai 3600, lalu naikkan ke 31536000).
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False

# DeepSeek API
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DJKI_REQUEST_RETRIES=3
DJKI_RETRY_BACKOFF_SECONDS=2
